APP_NAME=DeepShield AI
ENVIRONMENT=development

DATABASE_URL=sqlite:///./deepshield.db

# Required in production: if ENVIRONMENT=production and this is left at its
# default value, the app refuses to start (anyone could otherwise forge
# login tokens using this well-known placeholder from the public source).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Accepts a JSON array OR a plain comma-separated list — use whichever is
# easier to type into your host's environment-variable UI (e.g. Render).
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Deepfake detection
DETECTION_MODEL_NAME=dima806/deepfake_vs_real_image_detection
DETECTION_UPLOAD_DIR=./tmp_uploads
DETECTION_MAX_UPLOAD_MB=200
# DETECTION_ALLOWED_EXTENSIONS=.mp4,.mov,.avi,.mkv
DETECTION_FRAME_SAMPLE_SECONDS=1.0
DETECTION_MAX_FRAMES=30
DETECTION_FAKE_THRESHOLD=0.5
DETECTION_MAX_FRAME_DIMENSION=720

# Explainable AI
DETECTION_ENABLE_HEATMAP=true
HEATMAP_DIR=./static/heatmaps

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_DIR=./logs
LOG_LEVEL=INFO
